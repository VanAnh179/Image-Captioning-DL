# Deny by default. Keep only project source, tests, configs, and public docs.
*
!/.gitignore
!/README.md
!/AGENTS.md
!/docs/
!/docs/ktvic.md
!/requirements.txt
!/environment.yml
!/pyproject.toml

!/src/
!/src/**/
!/src/**/*.py
!/src/**/.gitkeep
!/scripts/
!/scripts/**/
!/scripts/**/*.py
!/scripts/**/.gitkeep
!/tests/
!/tests/**/
!/tests/**/*.py
!/tests/**/.gitkeep
!/demo/
!/demo/**/
!/demo/**/*.py
!/demo/**/.gitkeep
!/configs/
!/configs/**/
!/configs/**/*.yaml
!/configs/**/*.yml
!/configs/**/.gitkeep

# Keep internal handoff files and generated outputs local.
/reports/
/artifacts/
/runs/
/data/
/output/
/slides/

# Local files and secrets inside otherwise tracked directories.
private/
.env*
*.local.*
__pycache__/
.ipynb_checkpoints/
.venv/
